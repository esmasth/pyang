{
	// Use IntelliSense to learn about possible attributes.
	// Hover to view descriptions of existing attributes.
	// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
	"version": "0.2.0",
	"configurations": [
		{
			"name": "LSP server",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/bin/pyang",
			"console": "integratedTerminal",
			"preLaunchTask": "create_env",
			"justMyCode": false,
			"args": [
				"--verbose",
				"--keep-comments",
				"--lsp",
				"--lsp-mode=tcp",
				"--lsp-log-level=debug",
				"--no-env-path",
				// "--lint",
				// "--strict",
				// "--canonical",
				// "--max-line-length=160",
				// "--max-identifier-length=64",
				// "--path=${workspaceFolder}/modules",
				// "--path=/home/esmasth/code/test-sdk/yang",
				// "--ignore-path=${workspaceFolder}/modules/ietf",
				"--ericsson",
				"--ericsson-omp",
			]
		},
		{
			"name": "LSP client",
			"type": "debugpy",
			"request": "launch",
			"cwd": "${workspaceFolder}/test/test_lsp",
			"program": "client.py",
			"console": "integratedTerminal",
			"preLaunchTask": "create_env",
			"justMyCode": false,
			"args": []
		},
		{
			"name": "CLI",
			"type": "debugpy",
			"request": "launch",
			"program": "${workspaceFolder}/bin/pyang",
			"console": "integratedTerminal",
			"preLaunchTask": "create_env",
			"justMyCode": false,
			"args": [
				"--verbose",
				"--keep-comments",
				"--no-env-path",
				"--ericsson",
				"--strict",
				"--project-dir=/home/esmasth/code/m-plane-yang",
				// "--canonical",
				"--max-line-length=160",
				"--max-identifier-length=64",
				// "--path=${workspaceFolder}/modules",
				// "--path=/home/esmasth/code/test-sdk/yang",
				// "--ignore-path=${workspaceFolder}/modules/ietf",
				// "--ignore-path=/home/esmasth/code/m-plane-yang/Imported Models/ietf-interfaces.yang",
				"--ericsson",
				"--ericsson-omp",
				"--project-dir=/home/esmasth/code/m-plane-yang",
				"--path=/home/esmasth/code/m-plane-yang/Imported Models",
				"--path=/home/esmasth/code/m-plane-yang/Ericsson Models",
				"--path=/home/esmasth/code/m-plane-yang/Ericsson Models/EYANG",
				"/home/esmasth/code/m-plane-yang/Ericsson Models/ericsson-ieee802-ethernet-interface-ext-oru.yang",
			]
		},
		{
			"name": "Python Debugger: Remote Attach",
			"type": "debugpy",
			"request": "attach",
			"connect": {
				"host": "localhost",
				"port": 5678
			},
			"pathMappings": [
				{
					"localRoot": "${workspaceFolder}",
					"remoteRoot": "."
				}
			]
		}
	]
}
